# Default works with `docker-compose up` or a local `mongod` on the default port.
MONGO_URI=mongodb://localhost:27017
MONGO_TIMEOUT_MS=5000

# Comma-separated list of origins allowed to call this API (no spaces needed, they're trimmed).
# Add your deployed frontend's URL here when you have one.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
